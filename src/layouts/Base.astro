---
import baseCss from '../../styles/base.css?raw';
import { resolveOrigin, pageUrl } from '../lib/urls.mjs';

const { site, page, scheme } = Astro.props;
const origin = resolveOrigin(Astro.site, site.domain);
const canonical = pageUrl(origin, page.slug);

// The square logo stands in for the whole site wherever one picture is wanted: the link preview,
// the browser tab, and the schema.org Organization search engines read. Link previews and
// structured data need absolute addresses; a src that is already absolute (https://…) stays as it is.
const square = site.brand.square;
const squareUrl = square ? new URL(square.src, `${origin}/`).href : '';
const ICON_TYPES = { '.png': 'image/png', '.webp': 'image/webp', '.svg': 'image/svg+xml', '.jpg': 'image/jpeg', '.jpeg': 'image/jpeg' };
const iconType = square ? ICON_TYPES[(square.src.match(/\.[a-z0-9]+$/i)?.[0] ?? '').toLowerCase()] : undefined;
// JSON inside a <script> is closed by the first "</script>" it contains, wherever that is — even
// inside a string. Escaping every "<" as \u003c keeps the brand name (content written by someone
// else) from ever ending the tag early, and JSON readers decode it back to "<".
const organizationJson = square
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: site.brand.name,
      url: `${origin}/`,
      logo: squareUrl,
    }).replace(/</g, '\\u003c')
  : '';

// Header and footer are rendered here, in the layout every template shares, instead of as block
// files inside a template folder. Every other piece of markup in this engine is owned by exactly
// one template (resolved by template id + block type, see BlockRenderer.astro) and appears only
// on the pages whose content lists it. A header and footer are different: they belong to the
// SITE, not to any one page's block list, so there is no per-page content array to add a "header"
// block onto — `site.nav` and `site.footer` sit next to `site.pages`, not
// inside it (see normalizeSite in src/lib/normalize.mjs). Putting them here is what lets every
// page of a site share the exact same header/footer without every template having to duplicate
// that markup in its own hero/footer blocks.
//
// `site.nav` and `site.footer` are normalized the same way for every site
// regardless of which template renders it (always an array / plain objects, never undefined) —
// see normalizeSite. A site that never provided this data (every example that predates it) gets
// an empty nav and an all-blank footer, which is exactly what gates both sections off below, so
// those older examples keep building with no header or footer at all, unchanged.
const showHeader = site.nav.length > 0;

// The id the menu button opens. A heading's anchor is a slug of lowercase letters, digits and
// single hyphens (src/lib/anchors.mjs), so an id with a double underscore is one no section can
// ever be given — the button cannot end up opening a section instead of the menu.
const MENU_ID = 'site-header__menu';

// Trailing slashes are the only difference the same page can legitimately spell two ways: a slug
// written "/casino/" and a nav href written "/casino" are one page, and comparing the raw strings
// would leave the menu unmarked on exactly the sites whose content is written that way.
function normalizePath(value) {
  const path = typeof value === 'string' ? value.trim() : '';
  const trimmed = path.replace(/\/+$/, '');
  return trimmed === '' ? (path === '' ? '' : '/') : trimmed;
}

// The home page marks nothing. Its link in the menu, when a site has one, competes with the brand
// in the corner — which already leads home — for saying the same thing twice.
const currentPath = normalizePath(page.slug);
const activePath = currentPath === '/' ? '' : currentPath;

const footer = site.footer;
const showAgeBlock = footer.ageWarning !== '' || footer.ageText !== '';
const showFooter =
  showAgeBlock ||
  footer.quickLinksTitle !== '' ||
  footer.paymentsTitle !== '' ||
  footer.payments.length > 0 ||
  footer.copyright !== '';
---

<html lang={site.lang} dir={site.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{page.meta.title}</title>
    {page.meta.description && <meta name="description" content={page.meta.description} />}
    <link rel="canonical" href={canonical} />
    {site.geo && <meta name="geo.region" content={site.geo} />}
    <meta property="og:title" content={page.meta.title} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {square && <meta property="og:image" content={squareUrl} />}
    {square && <link rel="icon" type={iconType} href={square.src} />}
    {square && <link rel="apple-touch-icon" href={square.src} />}
    {square && <script type="application/ld+json" is:inline set:html={organizationJson} />}
    <style set:html={`${baseCss}\n${scheme.css}`}></style>
  </head>
  <body>
    {showHeader && (
      <header class="site-header">
        <div class="container site-header__inner">
          <a class="site-header__brand" href="/">
            {site.brand.logo ? (
              <img
                src={site.brand.logo.src}
                alt={site.brand.logo.alt || site.brand.name}
                width={site.brand.logo.width}
                height={site.brand.logo.height}
              />
            ) : (
              <span>{site.brand.name}</span>
            )}
          </a>
          <!-- Opens and closes the menu on a phone. popovertarget is the browser's own switch: a tap
               toggles the nav, a tap outside or Escape closes it, and a screen reader is told
               whether it is open — all without a line of script. Hidden on wider screens. -->
          <button class="site-header__toggle" type="button" popovertarget={MENU_ID} aria-label="Menu">
            <span class="site-header__toggle-bars" aria-hidden="true"></span>
          </button>
          <nav id={MENU_ID} class="site-header__nav" aria-label="Primary" popover>
            {site.nav.map((item) => {
              const isActive = activePath !== '' && normalizePath(item.href) === activePath;
              return (
                <a
                  href={item.href}
                  class:list={[isActive && 'is-active']}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {item.label}
                </a>
              );
            })}
          </nav>
        </div>
      </header>
    )}
    <!-- The page's blocks live inside <main>: search engines and screen readers use it to tell
         the page's own content from the header and footer repeated across every page. -->
    <main>
      <slot />
    </main>
    {showFooter && (
      <footer class="site-footer">
        <div class="container site-footer__grid">
          <div class="site-footer__brand">
            <p class="site-footer__brand-name">{site.brand.name}</p>
            {site.brand.tagline && <p class="site-footer__tagline">{site.brand.tagline}</p>}
            {showAgeBlock && (
              <div class="site-footer__age">
                {footer.ageWarning && (
                  <span class="site-footer__age-badge">{footer.ageWarning}</span>
                )}
                {footer.ageText && <p class="site-footer__age-text">{footer.ageText}</p>}
              </div>
            )}
          </div>
          {site.nav.length > 0 && (
            <div class="site-footer__col">
              {footer.quickLinksTitle && <h3>{footer.quickLinksTitle}</h3>}
              <ul class="site-footer__list">
                {site.nav.map((item) => (
                  <li><a href={item.href}>{item.label}</a></li>
                ))}
              </ul>
            </div>
          )}
          {footer.payments.length > 0 && (
            <div class="site-footer__col">
              {footer.paymentsTitle && <h3>{footer.paymentsTitle}</h3>}
              <ul class="site-footer__payments">
                {footer.payments.map((method) => (
                  <li>{method}</li>
                ))}
              </ul>
            </div>
          )}
        </div>
        {footer.copyright && (
          <div class="site-footer__bottom">
            <p class="container">{footer.copyright}</p>
          </div>
        )}
      </footer>
    )}
  </body>
</html>

<style>
  .site-header {
    /* On a phone the bar is held to this height, so the menu can open exactly beneath it. */
    --header-height: 4rem;
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-subtle);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-block: 1rem;
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    color: var(--text-primary);
    font-weight: 700;
    text-decoration: none;
  }

  .site-header__brand img {
    max-height: 2.25rem;
    width: auto;
  }

  /* The nav is a popover — what the menu button opens on a phone (see the phone rules below).
     Everywhere else, and in a browser too old to know popovers, it is simply the row of links, so
     the browser's own popover look (hidden, framed, fixed in the middle of the screen) is undone
     here, and the phone rules bring back only the parts they want. */
  .site-header__nav {
    position: static;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
    flex: 1 1 auto;
    width: auto;
    height: auto;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: visible;
    background: none;
    color: inherit;
  }

  .site-header__nav a {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.95rem;
  }

  .site-header__nav a:hover {
    color: var(--text-primary);
  }

  /* The page you are on, in the scheme's accent. aria-current carries the same fact for anyone who
     cannot see the colour. */
  .site-header__nav a.is-active {
    color: var(--accent-primary);
  }

  /* The menu button, drawn only where the menu is folded away (the phone rules below). */
  .site-header__toggle {
    display: none;
    flex-shrink: 0;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-primary);
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .site-header__toggle:hover,
  .site-header__toggle:focus-visible {
    border-color: var(--accent-primary);
    color: var(--accent-primary);
  }

  .site-header__toggle:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }

  /* Three bars drawn in CSS: the span is the middle one, its ::before and ::after the outer two.
     While the menu is open they fold into a cross — the middle bar fades, the outer two slide to
     the middle and turn 45° each way. */
  .site-header__toggle-bars,
  .site-header__toggle-bars::before,
  .site-header__toggle-bars::after {
    display: block;
    width: 1.25rem;
    height: 2px;
    border-radius: 2px;
    background-color: currentColor;
    transition:
      transform 0.3s ease,
      background-color 0.3s ease;
  }

  .site-header__toggle-bars {
    position: relative;
  }

  .site-header__toggle-bars::before,
  .site-header__toggle-bars::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .site-header__toggle-bars::before {
    transform: translateY(-6px) rotate(0);
  }

  .site-header__toggle-bars::after {
    transform: translateY(6px) rotate(0);
  }

  .site-header__inner:has(.site-header__nav:popover-open) .site-header__toggle-bars {
    background-color: transparent;
  }

  .site-header__inner:has(.site-header__nav:popover-open) .site-header__toggle-bars::before {
    transform: translateY(0) rotate(45deg);
  }

  .site-header__inner:has(.site-header__nav:popover-open) .site-header__toggle-bars::after {
    transform: translateY(0) rotate(-45deg);
  }

  /* On a phone the row of links would wrap into a block of its own under the brand, taller than
     the page's first line of content. Here it folds behind the button and opens as a panel beneath
     the bar. Only in a browser that knows popovers: anywhere else the button could not open
     anything, so it stays hidden and the links stay a row, as they always were. */
  @media (width < 48rem) {
    @supports selector(:popover-open) {
      .site-header__inner {
        flex-wrap: nowrap;
        min-height: var(--header-height);
        padding-block: 0;
      }

      /* A long brand name gives way to the button rather than pushing it off the screen. */
      .site-header__brand {
        min-width: 0;
      }

      .site-header__brand span {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .site-header__toggle {
        display: grid;
      }

      /* The panel spans the screen right under the bar, with the same background and the same
         hairline on top, so it reads as the bar unfolding. A menu longer than the screen scrolls
         inside the panel. It fades and drops in rather than appearing whole; a browser without
         these transitions just shows it at once. */
      .site-header__nav {
        position: fixed;
        inset: var(--header-height) 0 auto;
        max-height: calc(100dvh - var(--header-height));
        overflow-y: auto;
        flex-direction: column;
        flex-wrap: nowrap;
        gap: 0.35rem;
        padding: 0.75rem 1rem 1rem;
        background: var(--bg-secondary);
        border-top: 1px solid var(--border-subtle);
        border-bottom: 1px solid var(--border-default);
        box-shadow: 0 1.5rem 3rem rgb(0 0 0 / 0.35);
        opacity: 0;
        translate: 0 -0.5rem;
        transition:
          opacity 0.25s ease,
          translate 0.25s ease,
          display 0.25s allow-discrete,
          overlay 0.25s allow-discrete;
      }

      .site-header__nav:not(:popover-open) {
        display: none;
      }

      .site-header__nav:popover-open {
        opacity: 1;
        translate: 0;
      }

      @starting-style {
        .site-header__nav:popover-open {
          opacity: 0;
          translate: 0 -0.5rem;
        }
      }

      /* Each entry is a rounded row with a small dot before its label. The transparent left border
         is there so every label lines up with the active one, whose border is the accent bar. */
      .site-header__nav a {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        padding: 0.8rem 1rem;
        border-left: 3px solid transparent;
        border-radius: var(--radius);
        font-size: 1.05rem;
        transition:
          background-color 0.2s ease,
          color 0.2s ease;
      }

      .site-header__nav a::before {
        content: '';
        flex-shrink: 0;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--text-tertiary);
        opacity: 0.5;
      }

      .site-header__nav a:hover {
        background-color: var(--bg-elevated);
      }

      /* The page you are on: tinted with the accent and marked by an accent bar along its left
         edge, which the rounded corners bend into an arc. */
      .site-header__nav a.is-active {
        background-color: var(--accent-soft);
        border-left-color: var(--accent-primary);
      }

      /* The page under the open menu dims — but not the bar, so the button that closes it stays in
         plain sight. The height repeats as a fallback because older engines let ::backdrop inherit
         nothing, custom properties included. */
      .site-header__nav::backdrop {
        top: var(--header-height, 4rem);
        background-color: rgb(0 0 0 / 0);
        transition:
          background-color 0.25s ease,
          display 0.25s allow-discrete,
          overlay 0.25s allow-discrete;
      }

      .site-header__nav:popover-open::backdrop {
        background-color: rgb(0 0 0 / 0.55);
      }

      @starting-style {
        .site-header__nav:popover-open::backdrop {
          background-color: rgb(0 0 0 / 0);
        }
      }

      /* The page behind an open menu stays put instead of scrolling under the finger. */
      :global(body:has(.site-header__nav:popover-open)) {
        overflow: hidden;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__toggle,
    .site-header__toggle-bars,
    .site-header__toggle-bars::before,
    .site-header__toggle-bars::after,
    .site-header__nav,
    .site-header__nav::backdrop {
      transition: none;
    }
  }

  .site-footer {
    border-top: 1px solid var(--border-subtle);
    background: var(--bg-secondary);
    padding-block: 3rem 1.5rem;
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 2.5rem;
  }

  .site-footer__brand {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }

  .site-footer__brand-name {
    color: var(--text-primary);
    font-weight: 700;
    font-size: 1.1rem;
  }

  .site-footer__tagline {
    color: var(--text-secondary);
  }

  .site-footer__age {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .site-footer__age-badge {
    display: inline-block;
    width: max-content;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--border-accent);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .site-footer__age-text {
    color: var(--text-tertiary);
    font-size: 0.85rem;
    max-width: 32rem;
  }

  .site-footer__col h3 {
    margin-bottom: 1rem;
    color: var(--text-primary);
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .site-footer__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  .site-footer__list a {
    color: var(--text-secondary);
    text-decoration: none;
  }

  .site-footer__list a:hover {
    color: var(--text-primary);
  }

  .site-footer__payments {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .site-footer__payments li {
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    font-size: 0.85rem;
  }

  .site-footer__bottom {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
    color: var(--text-tertiary);
    font-size: 0.85rem;
  }
</style>
