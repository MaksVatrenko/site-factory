---
import { asRecords, asList, asText } from '../../_shared/props.mjs';

const { heading, items } = Astro.props;
const title = asText(heading);
const columns = asRecords(items)
  .map((item) => ({
    title: asText(item.title),
    links: asList(item.links)
      .map((link) => asText(link))
      .filter((link) => link !== ''),
  }))
  .filter((column) => column.title !== '' || column.links.length > 0);
---

{columns.length > 0 && (
  <section class="columns section section--surface">
    <div class="container">
      {title && <h2>{title}</h2>}
      <div class="columns__rows">
        {columns.map((column) => (
          <div class="columns__row">
            <h3>{column.title}</h3>
            {column.links.length > 0 && (
              <ul>
                {column.links.map((link) => (
                  <li>{link}</li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .columns__rows {
    margin-top: 1.75rem;
    display: grid;
    gap: 0.5rem;
  }

  .columns__row {
    display: grid;
    grid-template-columns: 14rem 1fr;
    gap: 1.5rem;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--c-border);
  }

  .columns__row ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    color: var(--c-muted);
  }

  @media (max-width: 760px) {
    .columns__row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
