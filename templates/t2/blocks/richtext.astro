---
import { asList, asText } from '../../_shared/props.mjs';

const { heading, paragraphs } = Astro.props;
const title = asText(heading);
const items = asList(paragraphs)
  .map((text) => asText(text))
  .filter((text) => text !== '');
---

{items.length > 0 && (
  <section class="richtext section">
    <div class="container richtext__grid">
      {title && <h2 class="richtext__heading">{title}</h2>}
      <div class="richtext__body">
        {items.map((text) => <p>{text}</p>)}
      </div>
    </div>
  </section>
)}

<style>
  .richtext__grid {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 2.5rem;
    align-items: start;
  }

  .richtext__heading {
    position: sticky;
    top: 2rem;
  }

  .richtext__body {
    display: grid;
    gap: 1rem;
  }

  @media (max-width: 760px) {
    .richtext__grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .richtext__heading {
      position: static;
    }
  }
</style>
