---
import { asText } from '../../_shared/props.mjs';

const { title, subtitle, cta, image, site } = Astro.props;
const buttonLabel = asText(cta, 'Подробнее');
---

<section class="hero">
  <div class="container hero__grid">
    <div class="hero__text">
      {site?.brand?.name && <p class="eyebrow">{site.brand.name}</p>}
      <h1>{asText(title, site?.brand?.name)}</h1>
      {subtitle && <p class="hero__subtitle">{subtitle}</p>}
      {site?.partnerUrl && <a class="button" href={site.partnerUrl}>{buttonLabel}</a>}
    </div>
    <div class="hero__aside">
      {image ? <img src={image} alt="" /> : <div class="hero__panel" />}
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space);
    border-bottom: 1px solid var(--c-border);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    align-items: center;
    gap: 3rem;
  }

  .hero__text {
    display: grid;
    gap: 1.15rem;
    justify-items: start;
  }

  .hero__subtitle {
    color: var(--c-muted);
    font-size: 1.15rem;
    max-width: 34rem;
  }

  .hero__panel {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    background: linear-gradient(140deg, var(--c-primary), var(--c-accent));
  }

  .hero__aside img {
    border-radius: var(--radius);
  }

  @media (max-width: 760px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
