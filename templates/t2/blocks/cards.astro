---
import { asRecords, asText } from '../../_shared/props.mjs';

const { heading, items } = Astro.props;
const title = asText(heading);
const cards = asRecords(items)
  .map((item) => ({ title: asText(item.title), text: asText(item.text) }))
  .filter((card) => card.title !== '' || card.text !== '');
---

{cards.length > 0 && (
  <section class="cards section">
    <div class="container">
      {title && <h2>{title}</h2>}
      <div class="cards__grid">
        {cards.map((card, index) => (
          <article class="card">
            <span class="card__number">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{card.title}</h3>
              <p>{card.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .cards__grid {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(22rem, 1fr));
    gap: 1.5rem 2.5rem;
  }

  .card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.1rem;
    padding-top: 1.25rem;
    border-top: 2px solid var(--c-primary);
  }

  .card__number {
    color: var(--c-primary);
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1;
  }

  .card h3 {
    margin-bottom: 0.4rem;
  }

  .card p {
    color: var(--c-muted);
  }
</style>
