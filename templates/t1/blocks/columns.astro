---
import { asRecords, asList, asText } from '../../_shared/props.mjs';

const { heading, items } = Astro.props;
const title = asText(heading);
const columns = asRecords(items)
  .map((item) => ({
    title: asText(item.title),
    links: asList(item.links)
      .map((link) => asText(link))
      .filter((link) => link !== ''),
  }))
  .filter((column) => column.title !== '' || column.links.length > 0);
---

{columns.length > 0 && (
  <section class="columns section">
    <div class="container">
      {title && <h2 class="columns__heading">{title}</h2>}
      <div class="columns__grid">
        {columns.map((column) => (
          <div class="columns__item">
            <h3>{column.title}</h3>
            {column.links.length > 0 && (
              <ul>
                {column.links.map((link) => (
                  <li>{link}</li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .columns__heading {
    margin-bottom: 2rem;
  }

  .columns__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 2rem;
  }

  .columns__item h3 {
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--c-primary);
  }

  .columns__item ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.4rem;
    color: var(--c-muted);
  }
</style>
