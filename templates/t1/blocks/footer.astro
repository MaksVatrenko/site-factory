---
import { asText } from '../../_shared/props.mjs';

const { site, cta } = Astro.props;
const year = new Date().getFullYear();
const disclaimer =
  'Материалы носят информационный характер и не являются публичной офертой.';
const buttonLabel = asText(cta, 'Подробнее');
const logoSrc = asText(site?.brand?.logo);
---

<footer class="footer section">
  <div class="container footer__inner">
    {logoSrc && <img class="footer__logo" src={logoSrc} alt="" />}
    <p class="footer__brand">{site?.brand?.name}</p>
    <p class="footer__disclaimer">{disclaimer}</p>
    <p class="footer__copy">© {year} {site?.domain}</p>
    {site?.partnerUrl && (
      <a class="button footer__cta" href={site.partnerUrl}>{buttonLabel}</a>
    )}
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--c-border);
    padding-block: 2.5rem;
  }

  .footer__inner {
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    text-align: center;
  }

  .footer__logo {
    max-height: 2.5rem;
    max-width: 10rem;
    width: auto;
    height: auto;
  }

  .footer__brand {
    font-weight: 700;
  }

  .footer__disclaimer,
  .footer__copy {
    color: var(--c-muted);
    font-size: 0.9rem;
  }

  .footer__cta {
    margin-top: 0.75rem;
  }
</style>
