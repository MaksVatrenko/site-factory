---
import { asRecords, asText } from '../../_shared/props.mjs';

const { heading, items } = Astro.props;
const title = asText(heading);
const questions = asRecords(items)
  .map((item) => ({ q: asText(item.q), a: asText(item.a) }))
  .filter((entry) => entry.q !== '' || entry.a !== '');
---

{questions.length > 0 && (
  <section class="faq section section--surface">
    <div class="container faq__inner">
      {title && <h2>{title}</h2>}
      <dl class="faq__list">
        {questions.map((item) => (
          <div class="faq__item">
            <dt>{item.q}</dt>
            <dd>{item.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
)}

<style>
  .faq__inner {
    max-width: 46rem;
  }

  .faq__list {
    margin-top: 1.75rem;
    display: grid;
    gap: 1.25rem;
  }

  .faq__item {
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--c-border);
  }

  .faq__item dt {
    font-weight: 650;
    margin-bottom: 0.35rem;
  }

  .faq__item dd {
    margin: 0;
    color: var(--c-muted);
  }
</style>
