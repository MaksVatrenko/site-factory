---
import { asList, asText } from '../../_shared/props.mjs';

const { heading, paragraphs } = Astro.props;
const title = asText(heading);
const items = asList(paragraphs)
  .map((text) => asText(text))
  .filter((text) => text !== '');
---

{items.length > 0 && (
  <section class="richtext">
    <div class="shell richtext__inner">
      {title && <h2>{title}</h2>}
      {items.map((text) => <p>{text}</p>)}
    </div>
  </section>
)}

<style>
  .richtext {
    padding-block: 2.5rem;
  }

  .richtext__inner {
    display: grid;
    gap: 1rem;
    padding-inline-start: 1.5rem;
    border-inline-start: 3px solid var(--c-primary);
  }
</style>
