---
import { asEntries, asText } from '../../_shared/props.mjs';
import Content from '../Content.astro';

// The first screen: the brand as an eyebrow, then whatever the content holds — normally the page's
// h1 and a lead paragraph or two. Pictures here load at once: a first-screen picture left lazy is
// exactly what the browser waits for before the page counts as loaded (LCP).
const { content, site, anchor, templateId } = Astro.props;
const entries = asEntries(content);
const anchorId = asText(anchor);
const brandLabel = asText(site?.brand?.name);
---

{entries.length > 0 && (
  <section class="hero section" id={anchorId || undefined}>
    <div class="container hero__inner">
      {brandLabel && <p class="hero__eyebrow">{brandLabel}</p>}
      <div class="hero__content">
        <Content
          content={entries}
          templateId={templateId}
          context={{ eagerImages: true, partnerUrl: asText(site?.partnerUrl) }}
        />
      </div>
    </div>
  </section>
)}

<style>
  /* The first screen is centred as a whole: text is centred in its line, and everything in the grid
     spans the container, so wide content (cards, a table) keeps its full width. The narrow pieces
     below are the exception — a brand pill, a heading or a list stretched to full width would read
     as a stray bar, so they shrink to their content and sit in the middle instead. */
  .hero__inner,
  .hero__content {
    display: grid;
    gap: 1.25rem;
    text-align: center;
  }

  .hero__content > :global(.rheading),
  .hero__content > :global(ul) {
    justify-self: center;
  }

  /* A centred list keeps its items flush with their bullets. The rows of pills and buttons are
     centred from here rather than from inside their own components: a section aligned left wants
     them flush left, and where a row sits is the enclosing block's decision, not the element's. */
  .hero__content > :global(ul) {
    text-align: left;
  }

  .hero__content > :global(.rinfo),
  .hero__content > :global(.rbuttons) {
    justify-content: center;
  }

  /* Same rule the section holds, for the same reason: what follows a line is an aside about what
     came above it. Written twice because each block scopes its own styles and there is nowhere
     both can reach — but a line drawn in one block and ignored in the other would be an element
     that works in half the places it is allowed. */
  .hero__content > :global(.rline) ~ :global(p) {
    color: var(--text-tertiary);
    font-size: 0.92rem;
  }

  .hero__eyebrow {
    justify-self: center;
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--border-default);
    border-radius: 999px;
    color: var(--text-secondary);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* The hero's own paragraphs read as a lead: larger and quieter than body text, held to a readable
     measure in the middle of the screen. They are drawn by the shared text element, so the look is
     applied from here — to direct children only, so a paragraph inside a card or a toggle placed in
     the hero keeps its own look. */
  .hero__content > :global(p) {
    max-width: 42rem;
    margin-inline: auto;
    color: var(--text-secondary);
    font-size: 1.15rem;
  }
</style>
