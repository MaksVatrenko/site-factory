---
import { asList, asText } from '../../_shared/props.mjs';

const { heading, title: legacyTitle, paragraphs, subtitle, site } = Astro.props;

// Templates must stay interchangeable: any content file has to build with any template. The older
// examples describe a hero as `title` + `subtitle`, this template's own content uses `heading` +
// `paragraphs`. Reading both costs two lines and keeps that guarantee true — without it a template
// silently renders an empty hero for content written for a different one.
const title = asText(heading, asText(legacyTitle));
const ownLead = asList(paragraphs)
  .map((text) => asText(text))
  .filter((text) => text !== '');
const lead = ownLead.length > 0 ? ownLead : asList(subtitle).map((t) => asText(t)).filter(Boolean);
const brandLabel = asText(site?.brand?.name);

// The reference site accents the last couple of words of the hero heading in gold. The content
// gives one plain heading string, not pre-split marker text, so the split happens here: every
// word but the last two renders plain, the last two (or the whole heading, if it is one or two
// words already) render inside the accent span.
const words = title.split(/\s+/).filter(Boolean);
const accentCount = Math.min(2, words.length);
const leadWords = words.slice(0, words.length - accentCount).join(' ');
const accentWords = words.slice(words.length - accentCount).join(' ');
---

{(title !== '' || lead.length > 0) && (
  <section class="hero section">
    <div class="container hero__inner">
      {brandLabel && <p class="hero__eyebrow">{brandLabel}</p>}
      {title && (
        <h1>
          {leadWords && `${leadWords} `}<span class="hero__accent">{accentWords}</span>
        </h1>
      )}
      {lead.map((paragraph) => (
        <p class="hero__lead">{paragraph}</p>
      ))}
    </div>
  </section>
)}

<style>
  .hero {
    text-align: center;
  }

  .hero__inner {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    max-width: 48rem;
  }

  .hero__eyebrow {
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--border-default);
    border-radius: 999px;
    color: var(--text-secondary);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero__accent {
    color: var(--accent-primary);
  }

  .hero__lead {
    color: var(--text-secondary);
    font-size: 1.15rem;
    max-width: 42rem;
  }
</style>
