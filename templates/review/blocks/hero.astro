---
import { asList, asText } from '../../_shared/props.mjs';
import RichText from '../RichText.astro';

const { heading, paragraphs, site, anchor } = Astro.props;

const anchorId = asText(anchor);
const title = asText(heading);
const lead = asList(paragraphs)
  .map((text) => asText(text))
  .filter((text) => text !== '');
const brandLabel = asText(site?.brand?.name);
---

{(title !== '' || lead.length > 0) && (
  <section class="hero section" id={anchorId || undefined}>
    <div class="container hero__inner">
      {brandLabel && <p class="hero__eyebrow">{brandLabel}</p>}
      {title && <h1 class="hero__title">{title}</h1>}
      {lead.map((paragraph) => (
        <p class="hero__lead"><RichText text={paragraph} /></p>
      ))}
    </div>
  </section>
)}

<style>
  .hero__inner {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
  }

  .hero__eyebrow {
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--border-default);
    border-radius: 999px;
    color: var(--text-secondary);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* The heading is painted with the scheme's gradient rather than a flat colour, matching the
     reference site: it runs across the whole heading box, so a second line starts part-way along
     the gradient rather than restarting it. The gradient itself belongs to the scheme, not here --
     a scheme that wants a flat heading sets --heading-gradient to a single colour. */
  .hero__title {
    background-image: var(--heading-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* Without background-clip the text would be painted in `transparent` -- that is, invisible. The
     colour is restored wherever the clip is unsupported, which is also what print and forced-
     colours modes fall back to. */
  @supports not ((-webkit-background-clip: text) or (background-clip: text)) {
    .hero__title {
      background-image: none;
      color: var(--text-primary);
    }
  }

  .hero__lead {
    color: var(--text-secondary);
    font-size: 1.15rem;
    max-width: 42rem;
  }
</style>
