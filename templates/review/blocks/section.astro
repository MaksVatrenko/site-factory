---
import { asRecords, asText } from '../../_shared/props.mjs';
import ElementRenderer from '../../../src/components/ElementRenderer.astro';

// A section carries an ordered `content` array instead of fixed named fields (heading,
// paragraphs, list, table, subsections) -- the content decides what a section contains and in
// what order, not this template. This file's job shrinks to the section shell: spacing, the
// anchor id, the container. Each entry's own look (a heading tag, list bullets, a table's scroll
// wrapper) lives in that entry's own element component -- see templates/review/elements/ and
// src/components/ElementRenderer.astro, which resolves and renders one entry at a time, in order.
const { content, anchor, templateId } = Astro.props;

// An entry that is not a plain object cannot carry a `type` and is dropped by asRecords the same
// defensive way any other collection in this codebase is coerced, never thrown. An entry with no
// usable `type` at all identifies nothing and is dropped here too -- ElementRenderer only warns
// about a `type` it can name but does not support, not about one that was never given.
const entries = asRecords(content).filter((entry) => asText(entry.type) !== '');
const hasContent = entries.length > 0;

// A heading is what a `toc` block's items link to (see toc.astro) -- omitted only when there is
// no heading, or nothing sensible survives slugifying it, rather than emitting a useless id="".
const anchorId = asText(anchor);
const idAttrs = anchorId ? { id: anchorId } : {};
---

{hasContent && (
  <section class="rsection section" {...idAttrs}>
    <div class="container rsection__inner">
      {entries.map((entry) => (
        <ElementRenderer entry={entry} templateId={templateId} />
      ))}
    </div>
  </section>
)}

<style>
  .rsection {
    scroll-margin-top: 5.5rem;
  }

  .rsection__inner {
    display: grid;
    gap: 1.1rem;
  }

  .rsection__inner:has(.rsection__table-wrap) {
    max-width: none;
  }
</style>
