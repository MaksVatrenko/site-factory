---
import { asList, asRecords, asText } from '../../_shared/props.mjs';

const { heading, items } = Astro.props;
const title = asText(heading);

// Entries arrive already paired with the anchor of the section they point at (see
// src/lib/anchors.mjs) — the pairing is by position, because a contents entry usually paraphrases
// the heading rather than repeating it. An entry whose section is missing keeps its label and
// renders as plain text: a link that goes nowhere is worse than no link.
const entries = asRecords(items)
  .map((item) => ({ text: asText(item.label), anchor: asText(item.anchor) }))
  .filter((entry) => entry.text !== '');
---

{entries.length > 0 && (
  <section class="toc section">
    <div class="container">
      <nav class="toc__card" aria-label={title || 'Table of contents'}>
        {title && <h2 class="toc__heading">{title}</h2>}
        <ul class="toc__grid">
          {entries.map((entry) => (
            <li>
              {entry.anchor ? (
                <a class="toc__link" href={`#${entry.anchor}`}>{entry.text}</a>
              ) : (
                <span class="toc__link toc__link--plain">{entry.text}</span>
              )}
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>
)}

<style>
  .toc__card {
    display: block;
    padding: 1.75rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border-default);
    border-top: 3px solid var(--border-accent);
    border-radius: var(--radius);
  }

  .toc__heading {
    margin-bottom: 1rem;
    font-size: 1.1rem;
  }

  .toc__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 0.6rem 1.5rem;
    list-style: none;
    padding: 0;
  }

  .toc__link {
    display: block;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease,
      color 0.15s ease;
  }

  a.toc__link:hover,
  a.toc__link:focus-visible {
    border-color: var(--border-accent);
    background: var(--bg-hover);
    color: var(--text-primary);
  }

  /* An entry with no section to point at is not interactive, so it must not look interactive. */
  .toc__link--plain {
    border-style: dashed;
    color: var(--text-tertiary);
  }

  .toc__link:hover {
    color: var(--accent-primary);
    text-decoration: underline;
  }
</style>
