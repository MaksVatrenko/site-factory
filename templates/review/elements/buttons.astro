---
import { asRecords, asText } from '../../_shared/props.mjs';
import { isSafeHref } from '../../_shared/rich-text.mjs';

// The call to action: one or two buttons side by side. The first is the accented one — the thing
// the page is actually for — and any after it are outlined, so a second choice reads as a second
// choice rather than as a rival.
//
// A button with no `href` of its own goes to the site's partner link. That is deliberate: the
// partner link is a setting of the build (see src/lib/site-context.mjs), not content, so asking the
// text to carry it would bake one campaign's address into every page written for it. A button that
// really does point somewhere else — another page of the site, an app store — says so with `href`,
// and is held to the same safety check every link in body text is (see rich-text.mjs: no
// `javascript:`, no protocol-relative address).
const { items, context } = Astro.props;
const partnerUrl = asText(context?.partnerUrl);

const buttons = asRecords(items)
  .map((item, index) => {
    // Trimmed before anything else looks at it. isSafeHref trims for its own check, so an address
    // padded with spaces passes it and then reaches the page padded — where `startsWith('http')`
    // is false, and an external link silently loses both its new tab and its rel="sponsored". The
    // same path for a link inside prose (parseRichText) trims, and these two must not disagree:
    // an unmarked paid link looks exactly like a marked one on the page.
    const own = asText(item.href).trim();
    const href = own === '' ? partnerUrl.trim() : own;
    // Which button is the loud one is decided by what was written, not by what survives. Numbering
    // after the filter would hand the accent to whatever is left — so a site with no partner link
    // loses its real call to action and makes "Download the app" the loudest thing on the page.
    return { text: asText(item.text), href: isSafeHref(href) ? href : '', accent: index === 0 };
  })
  // A button with no words on it is not a button, and one with nowhere to go is a dead end: both
  // are dropped rather than drawn. An external target opens in a new tab.
  .filter((button) => button.text !== '' && button.href !== '');
---

{buttons.length > 0 && (
  <div class="rbuttons">
    {buttons.map((button) => (
      <a
        class={button.accent ? 'rbuttons__button rbuttons__button--accent' : 'rbuttons__button'}
        href={button.href}
        {...(button.href.startsWith('http') ? { target: '_blank', rel: 'noopener sponsored' } : {})}
      >
        {button.text}
      </a>
    ))}
  </div>
)}

<style>
  .rbuttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .rbuttons__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 2rem;
    border: 1px solid var(--border-default);
    border-radius: var(--radius);
    color: var(--text-primary);
    font-size: 1.05rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      background 0.2s ease,
      box-shadow 0.2s ease;
  }

  .rbuttons__button:hover {
    border-color: var(--border-accent);
    background: var(--bg-hover);
  }

  /* The accented one carries the scheme's own gradient and glow, so it reads as the page's single
     loudest thing wherever a scheme puts its accent. */
  .rbuttons__button--accent {
    border-color: transparent;
    background: linear-gradient(100deg, var(--accent-primary), var(--accent-hover));
    color: var(--text-on-accent);
    box-shadow: 0 0 24px var(--accent-glow);
  }

  .rbuttons__button--accent:hover {
    background: linear-gradient(100deg, var(--accent-hover), var(--accent-primary));
    box-shadow: 0 0 32px var(--accent-glow);
  }

  @media (prefers-reduced-motion: reduce) {
    .rbuttons__button {
      transition: none;
    }
  }
</style>
