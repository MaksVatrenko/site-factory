---
import { asList, asText } from '../../_shared/props.mjs';
import RichText from '../RichText.astro';

const { items } = Astro.props;
// `items` being a single string rather than an array is a real, expected malformed shape (see
// data/sites/broken) -- asList wraps it into a one-item list instead of iterating its characters.
const values = asList(items)
  .map((item) => asText(item))
  .filter((item) => item !== '');
---

{values.length > 0 && (
  <ul class="rsection__list">
    {values.map((item) => (
      <li><RichText text={item} /></li>
    ))}
  </ul>
)}

<style>
  /* The browser's own bullet is drawn by ::marker, which takes a colour but not a shadow -- and
     the glow is the point. So the marker is turned off and the dot is a pseudo-element, which can
     carry both. */
  .rsection__list {
    display: grid;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
    color: var(--text-secondary);
  }

  .rsection__list li {
    position: relative;
    padding-left: 1.5rem;
  }

  .rsection__list li::before {
    content: '';
    position: absolute;
    left: 0.25rem;
    /* Half a line's height down, so the dot sits on the first line's middle whether the item
       wraps to three lines or none. */
    top: 0.58em;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--accent-primary);
    box-shadow: 0 0 8px var(--accent-glow);
  }
</style>
