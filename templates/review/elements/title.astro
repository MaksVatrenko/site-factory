---
// A thin pass-through: the tag rules and the look of a heading live in one place for the whole
// template (see templates/review/Heading.astro), because the toc, links and faq blocks render
// headings of their own that must match this one exactly.
import Heading from '../Heading.astro';

const { tag, text } = Astro.props;
---

<Heading tag={tag} text={text} />
