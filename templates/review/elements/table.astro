---
import { asList, asText } from '../../_shared/props.mjs';
import RichText from '../RichText.astro';

const { columns, rows } = Astro.props;
const cols = asList(columns)
  .map((cell) => asText(cell))
  .filter((cell) => cell !== '');
const tableRows = asList(rows)
  .map((row) => asList(row).map((cell) => asText(cell)))
  .filter((row) => row.some((cell) => cell !== ''));
// A table with columns but no rows (or the reverse) still renders -- an empty table with nothing
// at all in it does not. See data/sites/broken for the "table with no rows" case this covers.
const hasTable = cols.length > 0 || tableRows.length > 0;
---

{hasTable && (
  <div class="rsection__table-wrap">
    <table class="rsection__table">
      {cols.length > 0 && (
        <thead>
          <tr>
            {cols.map((column) => (
              <th scope="col">{column}</th>
            ))}
          </tr>
        </thead>
      )}
      {tableRows.length > 0 && (
        <tbody>
          {tableRows.map((row) => (
            <tr>
              {row.map((cell) => (
                <td><RichText text={cell} /></td>
              ))}
            </tr>
          ))}
        </tbody>
      )}
    </table>
  </div>
)}

<style>
  .rsection__table-wrap {
    max-width: 100%;
    /* A wide table scrolls inside its own frame rather than widening the page. `auto` also makes
       this a scroll container, which is what keeps the rounded corners clipping the header row. */
    overflow-x: auto;
    border: 1px solid var(--border-default);
    border-radius: var(--radius);
  }

  .rsection__table {
    width: 100%;
    border-collapse: collapse;
  }

  .rsection__table th,
  .rsection__table td {
    padding: 0.85rem 1.15rem;
    text-align: left;
    border-bottom: 1px solid var(--border-subtle);
  }

  /* The header is tinted with the accent rather than filled with it: at full strength a gold bar
     across the top of a table competes with the section heading above it. The solid rule
     underneath is what actually separates head from body.

     The gradient is painted on the row, not on the cells: a cell-by-cell gradient restarts at
     every column boundary, so a three-column table reads as three tinted blocks instead of one
     sweep across the whole header. */
  .rsection__table thead tr {
    background: linear-gradient(90deg, var(--accent-soft), transparent 70%);
  }

  .rsection__table thead th {
    border-bottom: 2px solid var(--accent-primary);
    color: var(--text-secondary);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .rsection__table tbody td {
    color: var(--text-secondary);
  }

  /* The first cell of a row names what the row is about, so it reads as the row's own label. */
  .rsection__table tbody td:first-child {
    color: var(--text-primary);
    font-weight: 600;
  }

  /* Striping, not colour: the rows only need to be told apart while the eye tracks across a wide
     row. --bg-subtle is a veil, so this reads the same whether the section behind it is the dark
     or the light half of the alternating pair. */
  .rsection__table tbody tr:nth-child(even) {
    background: var(--bg-subtle);
  }

  /* Slow enough to be seen. The row highlight is the only feedback a wide table gives that the
     eye and the cursor are on the same line, and at the default instant swap it registers as a
     flicker when the pointer crosses several rows in a row. */
  .rsection__table tbody tr {
    transition: background-color 0.35s ease;
  }

  .rsection__table tbody tr:hover {
    background: var(--bg-hover);
  }

  @media (prefers-reduced-motion: reduce) {
    .rsection__table tbody tr {
      transition: none;
    }
  }

  .rsection__table tbody tr:last-child td {
    border-bottom: 0;
  }
</style>
