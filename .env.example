# Настройки генерации картинок и логотипа через Runware (https://runware.ai).
# Скопируйте этот файл в .env и впишите ключ. Файл .env не попадает ни в git, ни в собранный сайт.
RUNWARE_API_KEY=
RUNWARE_API_URL=https://api.runware.ai/v1
RUNWARE_MODEL=runware:400@6
RUNWARE_GUIDANCE=2
# Модель рассчитана на 4 шага. Если качества не хватает, число можно поднять, но каждый шаг дороже.
RUNWARE_STEPS=4
RUNWARE_CONCURRENCY=1
# Модель, которая рисует надпись логотипа (умеет писать текст), и модель, которая убирает фон.
RUNWARE_LOGO_MODEL=ideogram:4@0
RUNWARE_BG_MODEL=ideogram:remove-background@0

# Генерация текстов через OpenAI (https://platform.openai.com). Ключ вписывается сюда же. Этот файл
# тоже не попадает ни в git, ни в собранный сайт.
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1/responses
OPENAI_MODEL=gpt-5.6-luna
# Цены в долларах за миллион токенов — под ту модель, что выбрана выше. OpenAI не присылает
# стоимость в ответе, поэтому фабрика считает её сама. Сменили модель — поменяйте и цены.
OPENAI_PRICE_INPUT=0.20
OPENAI_PRICE_CACHED_INPUT=0.02
OPENAI_PRICE_OUTPUT=1.20
